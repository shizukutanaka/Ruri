{
  "name": "ruri",
  "version": "0.2.0",
  "description": "World tuning / scale / chord backbone for DTM output",
  "license": "MIT",
  "author": "shizukutanaka",
  "repository": {
    "type": "git",
    "url": "https://github.com/shizukutanaka/ruri"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ruri": "bin/ruri.mjs"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:all": "vitest run",
    "coverage": "vitest run --coverage",
    "check:readme": "node scripts/check-readme-examples.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:readme && npm run test",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.0.0",
    "fast-check": "^3.23.2",
    "prettier": "^3.8.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.62.4"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
